<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Restrict this repository to nuget.org. The <clear /> drops any inherited
    sources (such as a machine-wide Telerik feed) so that restore is
    reproducible on every developer machine and in CI. The package source
    mapping satisfies NuGet rule NU1507, which requires Central Package
    Management to resolve from an unambiguous source.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
