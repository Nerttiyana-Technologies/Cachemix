<Project>

  <!-- Chain to the repository-root Directory.Build.props. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Packaging metadata -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/isureshsubramanian/Cachemix</PackageProjectUrl>
    <RepositoryUrl>https://github.com/isureshsubramanian/Cachemix</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>cache;caching;redis;memorycache;hybridcache;diagnostics;dashboard;observability;aspnetcore</PackageTags>

    <!-- Reproducible builds + SourceLink (SourceLink ships inside the .NET SDK). -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>

    <!-- Catch accidental breaking API changes across target frameworks. -->
    <EnablePackageValidation>true</EnablePackageValidation>

    <!-- MinVer derives the version from git tags: v1.2.3 -> 1.2.3 -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>

  <!-- Pack the repository README into every package. -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all" />
  </ItemGroup>

</Project>
