<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Cachemix.Hybrid</PackageId>
    <Description>HybridCache support for Cachemix — observes Microsoft.Extensions.Caching.Hybrid (the combined L1 in-memory and L2 distributed cache), including tags and value-factory timing. Keeps the HybridCache dependency out of Cachemix.Core.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Cachemix.Core/Cachemix.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cachemix.Hybrid.Tests" />
  </ItemGroup>

</Project>
