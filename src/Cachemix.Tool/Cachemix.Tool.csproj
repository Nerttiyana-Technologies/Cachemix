<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Cachemix.Tool</PackageId>
    <Description>dotnet-cachemix — a terminal client for Cachemix. Lists, inspects and nukes cache keys on a Redis, Garnet or Valkey server straight from the command line, with no running web host required. Install as a .NET global tool and invoke as 'cachemix'.</Description>

    <OutputType>Exe</OutputType>

    <!-- A .NET tool must build for a single framework, so the multi-target
         set inherited from src/Directory.Build.props is overridden here. -->
    <TargetFrameworks></TargetFrameworks>
    <TargetFramework>net8.0</TargetFramework>

    <!-- Pack as a .NET global tool: installing the package adds the
         `cachemix` command. RollForward=Major lets a net8.0 tool run on
         machines that only have a newer runtime. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>cachemix</ToolCommandName>
    <RollForward>Major</RollForward>

    <!-- A CLI executable needs neither an XML doc nor a package-validation
         baseline, and legitimately writes literal strings to the console. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnablePackageValidation>false</EnablePackageValidation>
    <NoWarn>$(NoWarn);CA1303</NoWarn>

    <PackageTags>cachemix;cache;redis;valkey;garnet;cli;dotnet-tool;diagnostics</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StackExchange.Redis" />
  </ItemGroup>

</Project>
